{
  "rewrites": [
    {
      "source": "/portfolio",
      "destination": "/portfolio.html"
    },
    {
      "source": "/portfolio/",
      "destination": "/portfolio.html"
    },
    {
      "source": "/ilovenona",
      "destination": "/ilovenona.html"
    },
    {
      "source": "/ilovenona/",
      "destination": "/ilovenona.html"
    },
    {
      "source": "/ilovenona/whenuneedme",
      "destination": "/ilovenona/whenuneedme.html"
    },
    {
      "source": "/ilovenona/whenuneedme/",
      "destination": "/ilovenona/whenuneedme.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/on",
      "destination": "https://on.aboustate.tech/",
      "permanent": false
    },
    {
      "source": "/on/",
      "destination": "https://on.aboustate.tech/",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/on?ping=1",
      "schedule": "0 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/on-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/on-manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    }
  ]
}